{
  "name": "@arthur/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Accesso ai dati: migrazioni SQL, lock, repository delle prenotazioni.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
