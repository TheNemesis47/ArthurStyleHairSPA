    "db:migrate": "node src/migrate.ts"
  },
  "dependencies": {
    "@arthur/core": "workspace:*",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
