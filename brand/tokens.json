{
  "$description": "Design token Arthur Style (formato W3C Design Tokens). Fonte: brand/palette.md. Verranno importati in packages/ui (F0/F3).",
  "color": {
    "carta":      { "$type": "color", "$value": "#FBF8F1", "$description": "Sfondo principale" },
    "inchiostro": { "$type": "color", "$value": "#726459", "$description": "Logo, testo secondario (5,38:1 su carta)" },
    "espresso":   { "$type": "color", "$value": "#2A201B", "$description": "Testo principale, pulsante primario (14,99:1)" },
    "castano":    { "$type": "color", "$value": "#563D30", "$description": "Link e accenti (9,40:1)" },
    "caramello":  { "$type": "color", "$value": "#A98F7D", "$description": "Solo decorativo: mai testo (2,86:1)" },
    "marmo":      { "$type": "color", "$value": "#E7E4DF", "$description": "Superfici secondarie" },
    "successo":   { "$type": "color", "$value": "#3E6B4F" },
    "attenzione": { "$type": "color", "$value": "#8A5A12" },
    "errore":     { "$type": "color", "$value": "#9B2C2C" }
  },
  "font": {
    "logo": { "$type": "fontFamily", "$value": ["Pinyon Script", "cursive"], "$description": "Solo logo e firme" },
    "ui":   { "$type": "fontFamily", "$value": ["Jost", "system-ui", "sans-serif"] }
  },
  "fontWeight": {
    "display": { "$type": "fontWeight", "$value": 320 },
    "body":    { "$type": "fontWeight", "$value": 400 },
    "strong":  { "$type": "fontWeight", "$value": 520 }
  },
  "line": {
    "ciocca": { "$type": "dimension", "$value": "0.55px", "$description": "Spessore delle linee del motivo a ciocche" }
  }
}
